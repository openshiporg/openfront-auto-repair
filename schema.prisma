  ownerships           VehicleOwnership[]  @relation("VehicleOwnership_vehicle")
  plates               PlateRegistration[] @relation("PlateRegistration_vehicle")
  odometerReadings     OdometerReading[]   @relation("OdometerReading_vehicle")
  appointments         Appointment[]       @relation("Appointment_vehicle")
  lastOdometer         Int?
  lastOdometerUnit     String              @default("mi")
  tireSpec             Json?               @default("{}")
  maintenanceIntervals Json?               @default("{}")
  notes                String              @default("")
  status               String              @default("active")
  version              Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt
  from_CheckIn_vehicle CheckIn[]           @relation("CheckIn_vehicle")

  @@index([vin])
  @@index([currentDecodeId])
}

model VehicleDecode {
  id                         String    @id @default(cuid())
  vehicle                    Vehicle?  @relation("VehicleDecode_vehicle", fields: [vehicleId], references: [id])
  vehicleId                  String?   @map("vehicle")
  provider                   String
  requestedVin               String    @default("")
  decoded                    Json?
  errorCode                  String    @default("")
  errorText                  String    @default("")
  fetchedAt                  DateTime? @default(now())
  fetchedBy                  User?     @relation("VehicleDecode_fetchedBy", fields: [fetchedById], references: [id])
  fetchedById                String?   @map("fetchedBy")
  from_Vehicle_currentDecode Vehicle[] @relation("Vehicle_currentDecode")

  @@index([vehicleId])
  @@index([requestedVin])
  @@index([fetchedById])
}

model VehicleOwnership {
  id                String           @id @default(cuid())
  vehicle           Vehicle?         @relation("VehicleOwnership_vehicle", fields: [vehicleId], references: [id])
  vehicleId         String?          @map("vehicle")
  customer          Customer?        @relation("VehicleOwnership_customer", fields: [customerId], references: [id])
  customerId        String?          @map("customer")
  businessAccount   BusinessAccount? @relation("VehicleOwnership_businessAccount", fields: [businessAccountId], references: [id])
  businessAccountId String?          @map("businessAccount")
  role              String
  startedAt         DateTime?        @postgresql.Date
  endedAt           DateTime?        @postgresql.Date
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([vehicleId])
  @@index([customerId])
  @@index([businessAccountId])
}

model Appointment {
  id                           String        @id @default(cuid())
  shop                         Shop?         @relation("Appointment_shop", fields: [shopId], references: [id])
  shopId                       String?       @map("shop")
  reference                    String        @unique @default("")
  customer                     Customer?     @relation("Appointment_customer", fields: [customerId], references: [id])
  customerId                   String?       @map("customer")
  vehicle                      Vehicle?      @relation("Appointment_vehicle", fields: [vehicleId], references: [id])
  vehicleId                    String?       @map("vehicle")
  lead                         Json?
  date                         DateTime?     @postgresql.Date
  startsAt                     DateTime?
  endsAt                       DateTime?
  kind                         String
  requestedServices            Json?         @default("[]")
  concernText                  String        @default("")
  estimatedCentiHours          Int           @default(0)
  bay                          Bay?          @relation("Appointment_bay", fields: [bayId], references: [id])
  bayId                        String?       @map("bay")
  assignedTech                 User?         @relation("Appointment_assignedTech", fields: [assignedTechId], references: [id])
  assignedTechId               String?       @map("assignedTech")
  source                       String
  status                       String        @default("requested")
  cancelReason                 String        @default("")
  checkIn                      CheckIn?      @relation("Appointment_checkIn", fields: [checkInId], references: [id])
  checkInId                    String?       @unique @map("checkIn")
  version                      Int           @default(0)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @default(now()) @updatedAt
  from_BookingHold_appointment BookingHold[] @relation("BookingHold_appointment")

  @@index([shopId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([bayId])
  @@index([assignedTechId])
  @@index([shopId, startsAt], map: "Appointment_shop_starts_idx")
  @@index([shopId, date, status], map: "Appointment_shop_date_status_idx")
}

model BookingHold {
  id            String       @id @default(cuid())
  shop          Shop?        @relation("BookingHold_shop", fields: [shopId], references: [id])
  shopId        String?      @map("shop")
  date          DateTime?    @postgresql.Date
  slotStart     DateTime?
  kind          String
  bayCentiHours Int?         @default(0)
  tokenHash     String       @unique @default("")
  source        String
  expiresAt     DateTime?
  status        String       @default("held")
  appointment   Appointment? @relation("BookingHold_appointment", fields: [appointmentId], references: [id])
  appointmentId String?      @map("appointment")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([shopId])
  @@index([appointmentId])
  @@index([shopId, date, status], map: "BookingHold_shop_date_status_idx")
}

model BookingRule {
  id            String   @id @default(cuid())
  shop          Shop?    @relation("BookingRule_shop", fields: [shopId], references: [id])
  shopId        String?  @map("shop")
  kind          String   @default("max_dropoffs_per_day")
  value         Json?
  appliesToDays Json?    @default("[]")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([shopId])
}

model CheckIn {
  id                           String                     @id @default(cuid())
  shop                         Shop?                      @relation("CheckIn_shop", fields: [shopId], references: [id])
  shopId                       String?                    @map("shop")
  reference                    String                     @unique @default("")
  appointment                  Appointment?               @relation("Appointment_checkIn")
  customer                     Customer?                  @relation("CheckIn_customer", fields: [customerId], references: [id])
  customerId                   String?                    @map("customer")
  vehicle                      Vehicle?                   @relation("CheckIn_vehicle", fields: [vehicleId], references: [id])
  vehicleId                    String?                    @map("vehicle")
  odometerIn                   OdometerReading?           @relation("CheckIn_odometerIn", fields: [odometerInId], references: [id])
  odometerInId                 String?                    @map("odometerIn")
  concerns                     Json?                      @default("[]")
  keyTag                       String                     @default("")
  waiter                       Boolean                    @default(false)
  promisedAt                   DateTime?
  contactPreference            String
  transportationNeed           String
  signatureMethod              String
  signerName                   String                     @default("")
  signature                    Json?
  signatureHash                String                     @default("")
  workOrderText                String                     @default("")
  workOrderHash                String                     @default("")
  signedAt                     DateTime?
  valuablesNote                String                     @default("")
  recallWarning                Json?
  jurisdictionPolicyVersion    JurisdictionPolicyVersion? @relation("CheckIn_jurisdictionPolicyVersion", fields: [jurisdictionPolicyVersionId], references: [id])
  jurisdictionPolicyVersionId  String?                    @map("jurisdictionPolicyVersion")
  at                           DateTime?                  @default(now())
  by                           User?                      @relation("CheckIn_by", fields: [byId], references: [id])
  byId                         String?                    @map("by")
  version                      Int                        @default(0)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @default(now()) @updatedAt
  from_OdometerReading_checkIn OdometerReading[]          @relation("OdometerReading_checkIn")

  @@index([shopId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([odometerInId])
  @@index([jurisdictionPolicyVersionId])
  @@index([byId])
}

enum UserKindType {
  staff
  customer_portal
  fleet_portal
  auditor
  machine
}
